erDiagram
    direction LR
    users {
        INT id PK "NOT NULL"
        VARCHAR(255) email UK "NOT NULL"
        VARCHAR(255) password_hash "NOT NULL"
        VARCHAR(50) role "NULL allowed"
        BOOLEAN is_active "NULL allowed"
        DATETIME created_at "NULL allowed"
    }
    recruiter_profiles {
        INT id PK "NOT NULL"
        INT user_id FK, UK "NOT NULL"
        VARCHAR(255) full_name "NOT NULL"
        VARCHAR(255) company_name "NOT NULL"
        VARCHAR(500) company_logo "NULL allowed"
        VARCHAR(255) designation "NULL allowed"
        VARCHAR(50) phone "NULL allowed"
        VARCHAR(500) company_website "NULL allowed"
        VARCHAR(100) company_size "NULL allowed"
        VARCHAR(255) industry "NULL allowed"
        TEXT bio "NULL allowed"
        VARCHAR(500) linkedin_url "NULL allowed"
        VARCHAR(255) location "NULL allowed"
        DATETIME updated_at "NULL allowed"
    }
    students {
        INT id PK "NOT NULL"
        INT user_id FK, UK "NOT NULL"
        VARCHAR(255) full_name "NOT NULL"
        VARCHAR(50) phone "NULL allowed"
        VARCHAR(500) avatar_url "NULL allowed"
        VARCHAR(20) gender "NULL allowed"
        VARCHAR(255) university "NULL allowed"
        VARCHAR(255) degree "NULL allowed"
        VARCHAR(255) field_of_study "NULL allowed"
        INT graduation_year "NULL allowed"
        FLOAT cgpa "NULL allowed"
        TEXT bio "NULL allowed"
        VARCHAR(255) location "NULL allowed"
        VARCHAR(50) preferred_mode "NULL allowed"
        VARCHAR(100) expected_stipend "NULL allowed"
        VARCHAR(500) portfolio_url "NULL allowed"
        VARCHAR(500) github_url "NULL allowed"
        VARCHAR(500) linkedin_url "NULL allowed"
        DATETIME updated_at "NULL allowed"
    }
    documents {
        INT id PK "NOT NULL"
        INT student_id FK "NOT NULL"
        VARCHAR(100) document_type "NOT NULL"
        VARCHAR(255) file_name "NOT NULL"
        VARCHAR(500) file_url "NULL allowed"
        VARCHAR(100) content_type "NULL allowed"
        INT file_size "NULL allowed"
        MEDIUMTEXT file_data "NULL allowed"
        DATETIME uploaded_at "NULL allowed"
    }
    skills {
        INT id PK "NOT NULL"
        VARCHAR(100) name UK "NOT NULL"
        VARCHAR(100) category "NULL allowed"
    }
    student_skills {
        INT id PK "NOT NULL"
        INT student_id FK "NOT NULL"
        INT skill_id FK "NOT NULL"
        VARCHAR(50) proficiency_level "NULL allowed"
    }
    internships {
        INT id PK "NOT NULL"
        INT recruiter_id FK "NULL allowed"
        VARCHAR(255) title "NOT NULL"
        VARCHAR(255) company_name "NOT NULL"
        VARCHAR(500) company_logo "NULL allowed"
        VARCHAR(255) location "NOT NULL"
        VARCHAR(50) mode "NULL allowed"
        INT stipend_amount "NOT NULL"
        VARCHAR(10) stipend_currency "NULL allowed"
        VARCHAR(100) duration "NOT NULL"
        TEXT description "NOT NULL"
        TEXT eligibility "NULL allowed"
        TEXT responsibilities "NULL allowed"
        TEXT benefits "NULL allowed"
        VARCHAR(255) recruiter_name "NULL allowed"
        VARCHAR(255) recruiter_email "NULL allowed"
        VARCHAR(255) recruiter_title "NULL allowed"
        VARCHAR(500) skills_required "NULL allowed"
        BOOLEAN is_external "NULL allowed"
        VARCHAR(500) external_link "NULL allowed"
        BOOLEAN is_active "NULL allowed"
        DATETIME deadline "NULL allowed"
        DATETIME created_at "NULL allowed"
    }
    applications {
        INT id PK "NOT NULL"
        INT student_id FK "NOT NULL"
        INT internship_id FK "NOT NULL"
        VARCHAR(50) status "NULL allowed"
        TEXT cover_letter "NULL allowed"
        MEDIUMTEXT resume_url "NULL allowed"
        DATETIME applied_at "NULL allowed"
        TEXT recruiter_notes "NULL allowed"
    }
    interviews {
        INT id PK "NOT NULL"
        INT recruiter_id FK "NOT NULL"
        INT application_id FK "NOT NULL"
        INT internship_id FK "NULL allowed"
        DATETIME scheduled_at "NOT NULL"
        INT duration_minutes "NULL allowed"
        VARCHAR(50) interview_type "NULL allowed"
        VARCHAR(500) meeting_link "NULL allowed"
        TEXT notes "NULL allowed"
        VARCHAR(50) status "NULL allowed"
        DATETIME created_at "NULL allowed"
    }
    notifications {
        INT id PK "NOT NULL"
        INT user_id FK "NOT NULL"
        VARCHAR(255) title "NOT NULL"
        TEXT message "NOT NULL"
        VARCHAR(50) type "NULL allowed"
        BOOLEAN is_read "NULL allowed"
        DATETIME created_at "NULL allowed"
    }
    saved_internships {
        INT id PK "NOT NULL"
        INT student_id FK "NOT NULL"
        INT internship_id FK "NOT NULL"
        DATETIME saved_at "NULL allowed"
    }
    messages {
        INT id PK "NOT NULL"
        INT sender_id FK "NOT NULL"
        INT receiver_id FK "NOT NULL"
        TEXT content "NOT NULL"
        BOOLEAN is_read "NULL allowed"
        DATETIME sent_at "NULL allowed"
    }
    users ||..o| recruiter_profiles : "user_id"
    users ||..o| students : "user_id"
    students ||..o{ documents : "student_id"
    students ||..o{ student_skills : "student_id"
    skills ||..o{ student_skills : "skill_id"
    recruiter_profiles |o..o{ internships : "recruiter_id"
    students ||..o{ applications : "student_id"
    internships ||..o{ applications : "internship_id"
    recruiter_profiles ||..o{ interviews : "recruiter_id"
    applications ||..o{ interviews : "application_id"
    internships |o..o{ interviews : "internship_id"
    users ||..o{ notifications : "user_id"
    students ||..o{ saved_internships : "student_id"
    internships ||..o{ saved_internships : "internship_id"
    users ||..o{ messages : "sender_id"
    users ||..o{ messages : "receiver_id"
